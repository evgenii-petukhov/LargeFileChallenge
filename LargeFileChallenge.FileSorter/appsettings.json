{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "IO": {
    "ReadBufferSize": 1048576,
    "WriteBufferSize": 1048576,
    "ChunkSize": 10485760,
    "ChunkNameTemplate": "chunk_{0}.txt"
  }
}
